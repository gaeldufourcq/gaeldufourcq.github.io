rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'msUHUjLvrdWwpU78j3Gwj1yNoxy1'; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Progression de chacun : privée
    match /data/users/{uid}/{doc} {
      allow read, write: if isMe(uid);
    }
    // Classement : tout le monde lit, chacun n'écrit que sa ligne
    match /board/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['pseudo','sues','serie','at'])
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 20
        && request.resource.data.sues is int && request.resource.data.serie is int;
      allow delete: if isMe(uid) || isOwner();
    }
    // Défi de la semaine par matière : tout le monde lit, chacun n'écrit que sa ligne
    match /weekly/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['pseudo','week','c','at'])
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 20
        && request.resource.data.week is string && request.resource.data.week.size() == 10
        && request.resource.data.c is map && request.resource.data.c.size() <= 30
        && request.resource.data.at is int;
      allow delete: if isMe(uid) || isOwner();
    }
    // Cartes validées : tout le monde lit, seul Gaël écrit
    match /cards/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    // Propositions : chacun écrit les siennes, seul Gaël les lit toutes
    match /proposals/{uid} {
      allow read, write: if isMe(uid) || isOwner();
    }
    // Pièges de la classe : liste anonyme des cartes « à revoir » de chacun
    match /traps/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['ko','at'])
        && request.resource.data.ko is list && request.resource.data.ko.size() <= 300
        && request.resource.data.at is int;
      allow delete: if isMe(uid);
    }
    // Présence en direct (en ligne, duels)
    match /rooms/{room}/peers/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }
  }
}
